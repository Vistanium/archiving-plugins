      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "include_summaries": {
            "description": "Add each page's machine-written summary.",
            "type": "boolean"
          },
          "issue_id": {
            "description": "The issue_id from a search result or page.",
            "type": "string"
          }
        },
        "required": [
          "issue_id"
        ],
        "type": "object"
      },
      "name": "archive_get_issue",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "citation": {
            "type": "string"
          },
          "complete": {
            "description": "False when positions in the issue's page sequence aren't held.",
            "type": "boolean"
          },
          "cover_page_url": {
            "description": "Link to the front cover. Absent when page 1 isn't held.",
            "type": "string"
          },
          "cover_thumbnail_url": {
            "description": "Small image of the scanned front cover. Absent when page 1 isn't held.",
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "issue_id": {
            "type": "string"
          },
          "issue_url": {
            "description": "The issue on Archivi.ng, opened at its first page: the link to give a reader for the whole issue.",
            "type": "string"
          },
          "missing_positions": {
            "description": "Positions in the page sequence the archive doesn't hold: usually pages that weren't scanned, occasionally a numbering quirk.",
