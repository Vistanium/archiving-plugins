    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Search the archive"
      },
      "description": "Search the archive's pages by words or exact phrases, with optional date range, publication and sort. Returns the total number of matching pages, how the query was read, a next_cursor for more results, and for each page its citation, a machine-written summary, the matching words and a link.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "description": "next_cursor from a previous archive_search with the same query and filters, to get the next results. There is no depth limit.",
            "type": "string"
          },
          "detail": {
            "description": "full (default) or brief: brief keeps the citation, date, link and match_type and leaves out summaries and matching words, for scanning many results cheaply.",
            "type": "string"
          },
          "entity_id": {
            "description": "Only pages tagged with this person, event, place or organisation, from archive_entity.",
            "type": "integer"
          },
          "from": {
            "description": "Earliest publication date: YYYY, YYYY-MM or YYYY-MM-DD.",
            "type": "string"
          },
          "keyword": {
            "description": "Only pages whose machine-made keywords match this, for example a name. Keywords aren't normalised; entity_id is more reliable for people.",
            "type": "string"
          },
          "limit": {
            "description": "Results per page, 1 to 20, or up to 100 with detail brief (for collecting many pages). Default 10.",
            "type": [
              "null",
              "integer"
            ]
          },
          "publication": {
            "description": "Publication slug from archive_coverage, for example african-concord.",
            "type": "string"
          },
          "query": {
            "description": "Words to search for. Put a phrase in double quotes to match it exactly, for example \"jollof rice\". Leave empty to browse by date or publication.",
            "type": "string"
          },
          "sort": {
            "description": "relevance (the default with words), oldest (the default with no words) or newest. Oldest and newest require every word to appear.",
            "type": "string"
          },
          "to": {
            "description": "Latest publication date: YYYY, YYYY-MM or YYYY-MM-DD.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "archive_search",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "help_url": {
            "description": "Present when the archive holds little or nothing for the filters: where the reader can ask the Archivi.ng team.",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "next_cursor": {
            "description": "Pass as cursor to get the next results; absent on the last.",
            "type": "string"
          },
          "query_as_read": {
            "additionalProperties": false,
            "properties": {
              "dates": {
                "type": "string"
              },
              "entity_id": {
                "type": "integer"
              },
              "keyword": {
                "type": "string"
              },
              "matching": {
                "type": "string"
              },
              "not_supported": {
                "description": "Operators in the query that were searched as ordinary words because search doesn't support them yet.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "pages_held": {
                "description": "With both from and to: pages the archive holds in those dates (and publication), whatever the query. A small number means the results are a small sample of what was printed.",
                "type": [
                  "null",
                  "integer"
                ]
              },
              "phrases": {
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "publication": {
                "type": "string"
              },
              "sort": {
                "type": "string"
              },
              "words": {
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              }
            },
            "required": [
              "sort",
              "matching"
            ],
            "type": "object"
          },
          "results": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "citation": {
                  "description": "Publication, date and page, ready to cite.",
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "date_precision": {
                  "description": "Present only when the date isn't exact: month or year, when only the issue's month or year is known.",
                  "type": "string"
                },
                "issue_id": {
                  "type": "string"
                },
                "machine_summary": {
                  "type": "string"
                },
                "match": {
                  "description": "The matching words on the page, with matches in «».",
                  "type": "string"
                },
                "match_type": {
                  "description": "literal_ocr: the words are in the page text; summary_match: in the summary; related: similar in meaning, the words may not appear.",
                  "type": "string"
                },
                "page_id": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "page_id",
                "citation",
                "date",
                "url"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "total",
          "query_as_read",
          "results"
        ],
        "type": "object"
      },
      "title": "Search the archive"
    },
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
