{
  "tools": [
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Count pages by year"
      },
      "description": "Count pages matching a query or tagged with an entity, over a range of at most 60 years: by year (default) or by publication. Each row has the pages held, so per_1000 compares fairly. Every word of a query must appear on a counted page.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "description": "Count pages tagged with this person, event, place or organisation, from archive_entity.",
            "type": "integer"
          },
          "from_year": {
            "description": "First year, for example 1960.",
            "type": "integer"
          },
          "group_by": {
            "description": "year (default) or publication: one row per publication with matches over the whole range.",
            "type": "string"
          },
          "publication": {
            "description": "Optional publication slug.",
            "type": "string"
          },
          "query": {
            "description": "Words or a quoted phrase to count, as in archive_search. Optional when entity_id is given.",
            "type": "string"
          },
          "to_year": {
            "description": "Last year, at most 60 years after from_year.",
            "type": "integer"
          }
        },
        "required": [
          "from_year",
          "to_year"
        ],
        "type": "object"
      },
      "name": "archive_count",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          },
          "publications": {
            "description": "With group_by publication: publications with at least one match, most matches first.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "matches": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "pages_held": {
                  "description": "Pages held for this publication within the queried years only, not its lifetime total (that is in archive_coverage).",
                  "type": "integer"
                },
                "per_1000": {
                  "description": "Matches per 1,000 pages held; null when nothing is held.",
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "publication": {
                  "type": "string"
                },
                "small_base": {
                  "description": "1 to 499 pages held, so per_1000 rests on few pages. With none held, per_1000 is null instead.",
                  "type": "boolean"
                }
              },
              "required": [
                "publication",
                "name",
                "matches",
                "pages_held",
                "per_1000",
                "small_base"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "query": {
            "type": "string"
          },
          "total_matches": {
            "type": "integer"
          },
          "years": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "matches": {
                  "type": "integer"
                },
                "pages_held": {
                  "description": "Pages held for that year (and publication, if given).",
                  "type": "integer"
                },
                "per_1000": {
                  "description": "Matches per 1,000 pages held; null when nothing is held, which is a gap in the archive, not a year without mentions.",
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "small_base": {
                  "description": "1 to 499 pages held, so per_1000 rests on few pages. With none held, per_1000 is null instead.",
                  "type": "boolean"
                },
                "year": {
                  "type": "integer"
                }
              },
              "required": [
                "year",
                "matches",
                "pages_held",
                "per_1000",
                "small_base"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          }
        },
        "required": [
          "total_matches",
          "note"
        ],
        "type": "object"
      },
      "title": "Count pages by year"
    },
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "What the archive holds"
      },
      "description": "Without publication: every publication in the archive with its slug, issues and pages held, and first and last issue, in one call. With a publication slug: issues held per year and the longest stretches with none held; add from and to to list every issue held in a window, so an absence can be told apart from a gap in holdings.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "description": "With publication: list the issues held from this date (YYYY, YYYY-MM or YYYY-MM-DD).",
            "type": "string"
          },
          "publication": {
            "description": "A publication slug for its holdings in detail. Leave empty for every publication at once.",
            "type": "string"
          },
          "to": {
            "description": "With publication: list the issues held up to this date (YYYY, YYYY-MM or YYYY-MM-DD).",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "archive_coverage",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "gaps": {
            "description": "Stretches with no issues held, much longer than the publication's usual interval: the archive doesn't hold those issues, which says nothing about whether they were printed. Longest 30, in date order.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "after": {
                  "description": "Last issue held before the gap.",
                  "type": "string"
                },
                "before": {
                  "description": "First issue held after the gap.",
                  "type": "string"
                },
                "days": {
                  "type": "integer"
                }
              },
              "required": [
                "after",
                "before",
                "days"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "help_url": {
            "description": "Present when no issue is held in the window: where the reader can ask the Archivi.ng team.",
            "type": "string"
          },
          "issues_held": {
            "description": "With from or to: the dates of every issue held in that window (at most 400). An empty list means none is held, not that none was printed.",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "note": {
            "type": "string"
          },
          "publication": {
            "additionalProperties": false,
            "properties": {
              "first_issue": {
                "type": "string"
              },
              "issues": {
                "type": "integer"
              },
              "last_issue": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "pages": {
                "type": "integer"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "slug",
              "issues",
              "pages"
            ],
            "type": [
              "null",
              "object"
            ]
          },
          "publications": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "first_issue": {
                  "type": "string"
                },
                "issues": {
                  "type": "integer"
                },
                "last_issue": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "pages": {
                  "type": "integer"
                },
                "slug": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "slug",
                "issues",
                "pages"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "total_pages": {
            "type": "integer"
          },
          "typical_days_between_issues": {
            "type": "integer"
          },
          "years": {
            "description": "Issues held per year, including years inside the span with none.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "issues": {
                  "type": "integer"
                },
                "year": {
                  "type": "integer"
                }
              },
              "required": [
                "year",
                "issues"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          }
        },
        "type": "object"
      },
      "title": "What the archive holds"
    },
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Find a person, event, place or organisation"
      },
      "description": "Find the people, events, places and organisations the archive has identified across its pages, by name. Returns each match's entity_id, name, type, a short description and how many pages are tagged with it. Use entity_id with archive_search or archive_count to work from the tags instead of spellings.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "A name to look up, for example Abacha or Murtala Muhammed.",
            "type": "string"
          },
          "type": {
            "description": "Optional: person, event, place or organisation.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "name": "archive_entity",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "matches": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "entity_id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "pages": {
                  "description": "Pages tagged with this entity in the archive.",
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "entity_id",
                "name",
                "type",
                "pages"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "matches"
        ],
        "type": "object"
      },
      "title": "Find a person, event, place or organisation"
    },
    {
      "annotations": {
