                "machine_summary": {
                  "type": "string"
                },
                "page_id": {
                  "type": "string"
                },
                "position": {
                  "type": "integer"
                },
                "url": {
                  "description": "Short link to the page; it redirects to the full address.",
                  "type": "string"
                }
              },
              "required": [
                "position",
                "page_id",
                "url"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "publication": {
            "type": "string"
          }
        },
        "required": [
          "issue_id",
          "citation",
          "publication",
          "date",
          "page_count",
          "complete",
          "pages"
        ],
        "type": "object"
      },
      "title": "Get an issue"
    },
